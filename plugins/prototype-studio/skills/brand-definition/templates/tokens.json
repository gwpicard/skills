{
  "$meta": {
    "name": "<brand> tokens",
    "version": "0.1.0",
    "sourceOfTruth": true,
    "note": "Builds use role tokens only. Primitives are referenced by roles, never used directly. Every value here is a placeholder to replace."
  },
  "primitive": {
    "gray": {
      "0": "#FFFFFF", "5": "#F7F7F5", "10": "#EDEDEA", "20": "#D8D8D3", "40": "#A3A39C",
      "60": "#6B6B65", "80": "#2E2E2B", "90": "#1E1E1C", "100": "#121211"
    },
    "accent": { "40": "#E0704B", "50": "#C9552E", "60": "#A8431F" }
  },
  "color": {
    "text": {
      "primary":   { "light": "{gray.90}", "dark": "{gray.5}",  "use": "text",   "meaning": "body and headings" },
      "secondary": { "light": "{gray.60}", "dark": "{gray.40}", "use": "text",   "meaning": "captions, labels" }
    },
    "surface": {
      "base":   { "light": "{gray.5}", "dark": "{gray.100}", "use": "fill", "meaning": "page background" },
      "raised": { "light": "{gray.0}", "dark": "{gray.90}",  "use": "fill", "meaning": "cards and panels" }
    },
    "border": {
      "subtle": { "light": "{gray.20}", "dark": "{gray.80}", "use": "stroke", "meaning": "dividers" }
    },
    "accent": {
      "signal": { "light": "{accent.60}", "dark": "{accent.40}", "use": "fill, stroke, large text", "meaning": "the one thing that matters on a screen; at most once per screen" }
    },
    "focus": { "light": "{accent.60}", "dark": "{accent.40}", "use": "stroke", "meaning": "keyboard focus ring" }
  },
  "contrast": { "text": 4.5, "largeText": 3, "nonText": 3 },
  "type": {
    "families": {
      "sans": { "name": "<family>", "fallback": "system-ui, -apple-system, 'Segoe UI', sans-serif", "licence": "fonts/LICENSES.md" },
      "mono": { "name": "<family>", "fallback": "ui-monospace, Menlo, monospace", "licence": "fonts/LICENSES.md" }
    },
    "styles": {
      "display":    { "family": "sans", "size": "clamp(48px, 6vw, 80px)", "lineHeight": 1.05, "weight": 500, "tracking": "0", "case": "sentence", "use": "one per page, hero only" },
      "h1":         { "family": "sans", "size": "40px", "lineHeight": 1.15, "weight": 500, "tracking": "0", "case": "sentence", "use": "page titles" },
      "h2":         { "family": "sans", "size": "28px", "lineHeight": 1.2,  "weight": 500, "tracking": "0", "case": "sentence", "use": "section titles" },
      "body":       { "family": "sans", "size": "17px", "lineHeight": 1.55, "weight": 400, "tracking": "0", "case": "sentence", "use": "running text, 60–75 characters per line" },
      "body-small": { "family": "sans", "size": "15px", "lineHeight": 1.5,  "weight": 400, "tracking": "0", "case": "sentence", "use": "secondary text" },
      "label":      { "family": "sans", "size": "13px", "lineHeight": 1.3,  "weight": 500, "tracking": "0.01em", "case": "sentence", "use": "form labels, metadata" }
    },
    "minSize": { "web": "13px", "slides": "18pt", "documents": "9pt" }
  },
  "space": { "unit": "8px", "scale": ["4px", "8px", "12px", "16px", "24px", "32px", "48px", "64px", "96px", "128px"] },
  "radius": { "none": "0", "small": "4px", "medium": "8px" },
  "layout": {
    "breakpoints": { "phone": "0", "tablet": "768px", "desktop": "1200px" },
    "columns": { "phone": 4, "tablet": 8, "desktop": 12 },
    "margin": { "phone": "16px", "tablet": "32px", "desktop": "64px" },
    "gutter": { "phone": "16px", "tablet": "24px", "desktop": "24px" },
    "imageRatios": ["1:1", "3:2", "16:9"]
  },
  "motion": {
    "duration": { "feedback": "90ms", "small": "200ms", "large": "400ms" },
    "easing": {
      "signature": "cubic-bezier(0.65, 0, 0.45, 1)",
      "enter": "cubic-bezier(0, 0, 0.38, 0.9)",
      "exit": "cubic-bezier(0.2, 0, 1, 0.9)"
    },
    "reducedMotion": "replace movement with an opacity change of at most 150ms"
  }
}
